{
  "manifest_version": 3,
  "name": "ResearchTabs",
  "version": "0.1.0",
  "description": "今のウィンドウのタブを出典の一覧(Markdown)にして、クリップボードか Obsidian へ渡す",
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }, "default_popup": "popup.html", "default_title": "ResearchTabs" },
  "options_page": "options.html",
  "permissions": ["tabs", "storage"]
}
